# Skim does not load this file itself; mise does (see mise.toml). Copy to .env if absent,
# edit it, run `mise trust` once, then start Skim with `mise exec -- ./bin/skim`
# (or plain ./bin/skim in a mise-activated shell). Restart Skim after changes.
# Keep real secrets out of version control; .env is git-ignored.

# GitHub remains environment-based. Model keys below are optional: explicitly add
# a named provider in Settings and set its Advanced API key env reference to use one.
# Otherwise paste and save the model key in Settings. Exporting keys creates no providers.
GITHUB_TOKEN=
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# Runtime (command-line flags override these)
SKIM_LISTEN=127.0.0.1:7437
SKIM_WEB_DIR=web/dist
# SKIM_DATA_DIR=/absolute/path/to/skim-state
# SKIM_DEV_ORIGIN=http://localhost:5173

# Initial GitHub setting (applies only to a new data directory; saved Settings win afterwards)
SKIM_GITHUB_TOKEN_ENV=GITHUB_TOKEN
# Providers and role models start empty. Add/name providers and assign models in Settings;
# legacy provider base-URL/model startup variables are no longer used.

# Optional ACP agent: executable, managed-worktree parent, JSON array of arguments.
# Do not put secrets in arguments. Use the flags documented by your chosen agent
# (e.g. for model selection); '[]' means no arguments.
# SKIM_ACP_COMMAND=/absolute/path/to/acp-agent
# SKIM_WORKTREE_ROOT=/absolute/path/to/worktrees
# Defaults to <SKIM_DATA_DIR>/workspaces. Existing user checkouts are never adopted.
# SKIM_ACP_ARGS='[]'
