{
  "name": "skim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:markdown": "tsx --test tests/markdown.test.ts",
    "test:diff": "tsx --test tests/diff.test.ts",
    "test:highlight": "tsx --test tests/highlight.test.ts",
    "test:suggestion": "tsx --test tests/suggestion.test.ts",
    "test:suggestion-ui": "node --conditions=browser --import tsx --import ./tests/register-svelte.ts --test tests/suggestion-ui.test.ts",
    "test:verify-panel": "node --conditions=browser --import tsx --import ./tests/register-svelte.ts --test tests/verify-panel-ui.test.ts",
    "test:concurrency": "node --conditions=browser --import tsx --import ./tests/register-svelte.ts --test tests/concurrency.test.ts"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "entities": "^8.1.0",
    "marked": "^18.1.0",
    "shiki": "^4.5.0"
  }
}
